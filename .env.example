# Ambiente: "development" (SQLite) ou "production" (PostgreSQL/Netlify)
NODE_ENV=development

# Produção — string do Netlify Database (Neon/PostgreSQL). NUNCA commitar a real.
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Segredo das sessões (gere um valor aleatório longo).
SESSION_SECRET=troque-por-um-valor-aleatorio-bem-longo

# Admin inicial criado pelo seed (senha NUNCA fica no código).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=defina-uma-senha-forte-aqui
